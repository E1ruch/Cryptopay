{
  "name": "@cryptopay/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/main.js",
    "lint": "eslint src test --ext .ts",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-fastify": "^11.2.1",
    "@nestjs/swagger": "^11.4.7",
    "fastify": "5.11.3",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^10.1.2",
    "@fastify/helmet": "^13.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "jose": "^5.9.6",
    "otpauth": "^9.3.6",
    "ioredis": "^5.4.2",
    "zod": "^3.24.1",
    "@cryptopay/config": "workspace:*",
    "@cryptopay/database": "workspace:*",
    "@cryptopay/logger": "workspace:*",
    "@cryptopay/crypto": "workspace:*",
    "@cryptopay/shared": "workspace:*",
    "@cryptopay/validation": "workspace:*",
    "@cryptopay/payments": "workspace:*",
    "@cryptopay/blockchain": "workspace:*",
    "@cryptopay/webhooks": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "dotenv": "^16.4.7",
    "@nestjs/testing": "^11.2.1",
    "unplugin-swc": "^1.5.1",
    "@swc/core": "^1.10.1"
  }
}
