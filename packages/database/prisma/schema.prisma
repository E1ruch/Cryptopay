// CryptoPay database schema — Phase 0 (Auth core + multi-tenant foundation).
// Every merchant-owned table carries organization_id (spec §12) — object
// lookups must always filter by it; never trust a bare resource id.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  LOCKED
  SUSPENDED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  PENDING_REVIEW
  CLOSED
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum ApiKeyEnvironment {
  test
  live
}

// Invoice lifecycle (spec §16). A state machine in packages/payments governs
// legal transitions — this enum only constrains the value domain; §88
// forbids mutating `status` without going through that domain validation.
enum InvoiceStatus {
  CREATED
  PENDING
  DETECTED
  CONFIRMING
  PAID
  UNDERPAID
  OVERPAID
  EXPIRED
  FAILED
  CANCELLED
  REFUNDED
}

// A single payment attempt's blockchain-detection lifecycle (spec §17/§87).
// One invoice can carry multiple attempts; the invoice's own status is the
// merchant-facing aggregate derived from its attempts.
enum PaymentStatus {
  PENDING
  DETECTED
  CONFIRMING
  CONFIRMED
  UNDERPAID
  OVERPAID
  FAILED
  REORG_DETECTED
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXHAUSTED
}

// ─── Auth / Users ────────────────────────────────────────────────────────

model User {
  id     String     @id @default(cuid())
  email  String     @unique
  status UserStatus @default(PENDING_VERIFICATION)

  passwordHash String @map("password_hash")

  emailVerifiedAt DateTime? @map("email_verified_at")

  twoFactorEnabled   Boolean @default(false) @map("two_factor_enabled")
  twoFactorSecretEnc String? @map("two_factor_secret_enc")

  // Account lockout / risk controls (spec §31).
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")

  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  memberships             Membership[]
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]

  @@map("users")
}

// Refresh tokens are stored hashed and rotated on every use. `familyId`
// groups a rotation chain: reuse of an already-rotated token indicates
// token theft and must revoke the entire family (spec §31).
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  tokenHash    String    @unique @map("token_hash")
  familyId     String    @map("family_id")
  replacedById String?   @unique @map("replaced_by_id")
  revokedAt    DateTime? @map("revoked_at")
  expiresAt    DateTime  @map("expires_at")
  userAgent    String?   @map("user_agent")
  ipAddress    String?   @map("ip_address")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// ─── Organizations / multi-tenancy ──────────────────────────────────────

model Organization {
  id     String             @id @default(cuid())
  name   String
  slug   String             @unique
  status OrganizationStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships      Membership[]
  apiKeys          ApiKey[]
  auditLogs        AuditLog[]
  idempotencyKeys  IdempotencyKey[]
  invoices         Invoice[]
  payments         Payment[]
  webhookEndpoints WebhookEndpoint[]
  webhookEvents    WebhookEvent[]

  @@map("organizations")
}

model Membership {
  id             String         @id @default(cuid())
  userId         String         @map("user_id")
  organizationId String         @map("organization_id")
  role           MembershipRole @default(MEMBER)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

// ─── API keys ────────────────────────────────────────────────────────────

model ApiKey {
  id             String            @id @default(cuid())
  organizationId String            @map("organization_id")
  name           String
  environment    ApiKeyEnvironment

  // Raw key is shown once and never stored (spec §15). keyPrefix is safe to
  // display for identification; keyHash is HMAC-SHA256(pepper, rawKey).
  keyPrefix String @map("key_prefix")
  keyHash   String @unique @map("key_hash")

  scopes String[]

  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("api_keys")
}

// ─── Audit log (append-only from the application's perspective) ─────────

model AuditLog {
  id             String  @id @default(cuid())
  organizationId String? @map("organization_id")
  actorId        String? @map("actor_id")
  actorType      String  @map("actor_type") // "user" | "api_key" | "admin" | "system"
  action         String
  resourceType   String  @map("resource_type")
  resourceId     String? @map("resource_id")
  ip             String?
  userAgent      String? @map("user_agent")
  metadata       Json?

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Idempotency ─────────────────────────────────────────────────────────

model IdempotencyKey {
  id             String @id @default(cuid())
  organizationId String @map("organization_id")
  key            String

  // Hash of method+path+body — reusing the same Idempotency-Key with a
  // different request body is a client error, not a legitimate replay.
  requestHash    String @map("request_hash")
  responseStatus Int?   @map("response_status")
  responseBody   Json?  @map("response_body")

  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("idempotency_keys")
}

// ─── Payments (Phase 1 — spec §16/§17) ────────────────────────────────────

// `id` is an opaque, prefixed public identifier (e.g. "inv_...", generated by
// the application via generateId('inv')) rather than a bare cuid — this IS
// the identifier merchants and the public checkout page see, so it must
// never be sequential or otherwise guessable (spec §48).
model Invoice {
  id             String        @id
  organizationId String        @map("organization_id")
  externalId     String?       @map("external_id")
  status         InvoiceStatus @default(CREATED)

  description String?

  // Amount denominated in `token` (e.g. 49.00 USDC) — Decimal, never float
  // (spec §18). `currency` is the merchant-facing fiat reference only; no FX
  // conversion happens in Phase 1 (fake payments, stablecoin-only).
  amount   Decimal @db.Decimal(20, 8)
  currency String
  token    String
  network  String

  // Globally unique — the scanner matches an incoming transfer to exactly
  // one invoice by this address alone (packages/payments matchesInvoice).
  // One dedicated address per invoice, never reused (spec §16).
  paymentAddress String @unique @map("payment_address")

  successUrl String? @map("success_url")
  cancelUrl  String? @map("cancel_url")
  metadata   Json?

  expiresAt DateTime  @map("expires_at")
  paidAt    DateTime? @map("paid_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payments      Payment[]
  webhookEvents WebhookEvent[]

  // spec §26: (organization_id, external_id) is an idempotency boundary —
  // retried invoice-creation requests must not create duplicates.
  @@unique([organizationId, externalId])
  @@index([organizationId])
  @@index([status])
  @@map("invoices")
}

// One row per payment attempt (spec §17) — an invoice may accumulate several
// as a customer retries. `id` is an opaque public id (e.g. "pay_...").
model Payment {
  id             String @id
  invoiceId      String @map("invoice_id")
  organizationId String @map("organization_id")

  network String
  token   String

  expectedAmount Decimal  @map("expected_amount") @db.Decimal(20, 8)
  receivedAmount Decimal? @map("received_amount") @db.Decimal(20, 8)

  txHash        String? @map("tx_hash")
  fromAddress   String? @map("from_address")
  toAddress     String  @map("to_address")
  blockNumber   BigInt? @map("block_number")
  confirmations Int     @default(0)

  status PaymentStatus @default(PENDING)

  detectedAt  DateTime? @map("detected_at")
  confirmedAt DateTime? @map("confirmed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // spec §26: (network, tx_hash) idempotency boundary for blockchain event
  // processing. Multiple NULL tx_hash rows (pre-detection) are not deduped
  // by Postgres, which is correct — each is a distinct pending attempt.
  @@unique([network, txHash])
  @@index([invoiceId])
  @@index([organizationId])
  @@map("payments")
}

// ─── Webhooks (spec §27–§29, §61) ─────────────────────────────────────────

model WebhookEndpoint {
  id             String  @id
  organizationId String  @map("organization_id")
  url            String
  enabled        Boolean @default(true)

  // Signing secret, AES-256-GCM encrypted at rest (packages/crypto
  // encryptSecret) — must be readable again to compute HMAC-SHA256
  // signatures on outgoing deliveries, unlike API keys which are hashed.
  secretEnc String @map("secret_enc")

  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([organizationId])
  @@map("webhook_endpoints")
}

// A domain event (e.g. "payment.paid"), fanned out to every enabled
// endpoint on the organization as one WebhookDelivery each.
model WebhookEvent {
  id             String @id
  organizationId String @map("organization_id")
  invoiceId      String @map("invoice_id")
  type           String

  data Json

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([organizationId])
  @@index([invoiceId])
  @@map("webhook_events")
}

// One delivery attempt record per (event, endpoint) — spec §28 fields.
model WebhookDelivery {
  id         String @id
  eventId    String @map("event_id")
  endpointId String @map("endpoint_id")

  attempt        Int                   @default(1)
  status         WebhookDeliveryStatus @default(PENDING)
  statusCode     Int?                  @map("status_code")
  responseTimeMs Int?                  @map("response_time_ms")
  error          String?

  nextRetryAt DateTime? @map("next_retry_at")
  deliveredAt DateTime? @map("delivered_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  event    WebhookEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  // One row per (event, endpoint) — guards against the dispatch scanner
  // double-creating a delivery for the same pair on overlapping poll ticks.
  @@unique([eventId, endpointId])
  @@index([eventId])
  @@index([endpointId])
  @@index([status, nextRetryAt])
  @@map("webhook_deliveries")
}
