# Copy to .env for local development. NEVER commit a real .env file.
# Production secrets must come from a secrets manager (see docs/security/SECRETS.md), not this file.

NODE_ENV=development
LOG_LEVEL=info
# false for local http:// dev; true in any real (TLS-terminated) deployment.
COOKIE_SECURE=false

# API
API_PORT=3010
API_BASE_URL=http://localhost:3010
CORS_ORIGINS=http://localhost:3000

# Web / Checkout
WEB_BASE_URL=http://localhost:3000
CHECKOUT_BASE_URL=http://localhost:3000/pay
# Baked into the browser bundle at build time — must be reachable from the client.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3010

# Database (docker-compose service name "postgres" when running in containers)
DATABASE_URL=postgresql://cryptopay:cryptopay@localhost:5433/cryptopay

# Redis (docker-compose service name "redis" when running in containers)
REDIS_URL=redis://localhost:6380

# Secrets — generate locally with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
SESSION_COOKIE_SECRET=
CSRF_SECRET=
API_KEY_PEPPER=
ENCRYPTION_KEY=

# Token lifetimes (seconds)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Argon2id parameters
ARGON2_MEMORY_COST_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Rate limiting
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_GLOBAL_PER_MINUTE=300

# Blockchain (spec §24/§93)
# 'fake' — Phase 1's in-memory chain, zero external calls, no setup needed.
# 'evm'  — Phase 2's real Base Sepolia adapter; also requires each
#          organization to set a MerchantWalletAddress before creating an
#          invoice (see the dashboard's Wallet Address settings).
BLOCKCHAIN_MODE=fake
REQUIRED_CONFIRMATIONS=3
BLOCKCHAIN_BLOCK_TIME_MS=2000
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
RATE_LIMIT_CHECKOUT_PER_MINUTE=100
